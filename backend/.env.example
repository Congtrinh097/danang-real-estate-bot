OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL_NAME=text-embedding-3-small
# Router model
ROUTER_MODEL_NAME=typesafe/jev-1.14
ROUTER_BASE_URL=https://openrouter.ai/api/v1
ROUTER_API_KEY=
# Vector DB (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=danang_properties

# Relational DB (PostgreSQL Checkpoint & Leads)
DATABASE_URL=postgresql://admin:danang_realestate_secret@localhost:5432/danang_real_estate

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=danang-real-estate-bot
